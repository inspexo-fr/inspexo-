{
  "crons": [
    {
      "path": "/api/alertes",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/a/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebookcatalog|Facebot|[Tt]witterbot|[Ww]hats[Aa]pp|[Ll]inked[Ii]n[Bb]ot|[Tt]elegram[Bb]ot|[Ss]lackbot|Slack-ImgProxy|[Dd]iscordbot|[Pp]interest|redditbot|SkypeUriPreview|vkShare|iMessageLinkPreview).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/go/:slug",
      "destination": "/api/go"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/takata",
      "destination": "/airbags-takata",
      "statusCode": 301
    }
  ],
  "functions": {
    "api/og-image.js": {
      "includeFiles": "node_modules/@vercel/og/dist/**",
      "memory": 1024,
      "maxDuration": 15
    }
  }
}
